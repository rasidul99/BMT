# API Backend URL (Optional if using built-in Next.js /api routes)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Facebook / Meta Page Credentials (BMT Page Manager App)
NEXT_PUBLIC_FB_APP_ID=
NEXT_PUBLIC_FB_APP_SECRET=

# Active Facebook Page ID & Long-Lived Token (e.g. CARE HUB BD)
NEXT_PUBLIC_FB_PAGE_ID_CARE_HUB_BD=
NEXT_PUBLIC_FB_PAGE_TOKEN_CARE_HUB_BD=
